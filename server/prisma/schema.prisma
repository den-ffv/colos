generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Language {
  ENG
  UA
}

enum AccountType {
  user
  customer
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      Json
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@map("sessions")
}

model User {
  id        String   @id @default(cuid())
  login     String   @unique
  email     String   @unique
  password  String
  name      String?
  language  Language @default(UA)
  is_active Boolean  @default(true)

  UserRoles UserRole[]

  @@map("users")
}

model Role {
  id            String  @id @default(cuid())
  name          String  @unique
  is_admin      Boolean @default(false)
  is_logistic   Boolean @default(false)
  is_manager    Boolean @default(false)
  is_driver     Boolean @default(false)
  is_dispatcher Boolean @default(false)
  is_user       Boolean @default(true)
  is_active     Boolean @default(true)

  UserRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String  @id @default(cuid())
  user_id   String
  role_id   String
  is_active Boolean @default(true)

  user User @relation(fields: [user_id], references: [id])
  role Role @relation(fields: [role_id], references: [id])

  @@unique([user_id, role_id])
  @@map("user_roles")
}

model Company {
  id        String  @id @default(cuid())
  name      String
  full_name String?
  address   String?
  phone     String?
  email     String?
  is_active Boolean @default(true)

  transportUnits TransportUnit[]

  @@map("companies")
}

model ContractStatus {
  id             String  @id @default(cuid())
  name           String  @unique
  is_new         Boolean @default(false)
  is_in_progress Boolean @default(false)
  is_completed   Boolean @default(false)
  is_closed      Boolean @default(false)
  is_active      Boolean @default(true)

  @@map("contract_statuses")
}

model TransportType {
  id             String  @id @default(cuid())
  name           String  @unique
  is_truck       Boolean @default(false)
  is_minibus     Boolean @default(false)
  is_lightweight Boolean @default(false)
  is_active      Boolean @default(true)

  transportUnits TransportUnit[]

  @@map("transport_types")
}

model TransportUnit {
  id                  String        @id @default(cuid())
  registration_number String        @unique
  transport_type_id   String
  transport_type      TransportType @relation(fields: [transport_type_id], references: [id])
  company_id          String
  company             Company       @relation(fields: [company_id], references: [id])
  model               String?
  year                Int?
  capacity            Float?
  is_active           Boolean       @default(true)

  @@map("transport_units")
}

model RoadFreightContractor {
  id           String      @id @default(cuid())
  company_name String
  contact_name String?
  phone        String?
  email        String?
  address      String?
  account_type AccountType @default(user)
  is_active    Boolean     @default(true)

  contracts Contract[]

  @@map("road_freight_contractors")
}

model Contract {
  id                String   @id @default(cuid())
  customer_name     String
  customer_phone    String
  departure_point   Json // {name: string, address: string, coordinates: [lng, lat]}
  destination_point Json // {name: string, address: string, coordinates: [lng, lat]}
  departure_date    DateTime
  departure_time    String
  passenger_count   Int
  additional_info   String?
  route_data        Json? // Дані маршруту з Mapbox
  status            String   @default("new")
  total_price       Float?

  contractor_id String?
  contractor    RoadFreightContractor? @relation(fields: [contractor_id], references: [id])

  created_by String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("contracts")
}
