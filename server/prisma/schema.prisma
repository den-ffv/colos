generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationMode {
  OWN_FLEET  // Власний автопарк
  BROKER     // Брокер
  HYBRID     // Змішаний режим
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ExecutionType {
  INTERNAL  // Своїми ресурсами
  EXTERNAL  // Сторонній перевізник
}

enum VehicleType {
  TRUCK
  VAN
  CAR
  REFRIGERATOR
}

enum UiLanguage {
  ENG
  UA
}

enum Role {
  ADMIN
  MANAGER
  DISPATCHER
  ACCOUNTANT
  LOGIST
  DRIVER
}

model Company {
  id                   String          @id @default(uuid())
  name                 String
  email                String?
  phone                String?
  address              String?
  operation_mode       OperationMode   @default(HYBRID)
  has_own_fleet        Boolean         @default(true)
  uses_broker_services Boolean         @default(true)
  created_at           DateTime        @default(now())
  updated_at           DateTime        @updatedAt
  
  Users           User[]
  Clients         Client[]
  Drivers         Driver[]
  Vehicles        Vehicle[]
  Carriers        Carrier[]
  Orders          Order[]
  
  @@map("companies")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  password     String
  first_name   String
  last_name    String
  is_active    Boolean     @default(true)
  company_id   String
  company      Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  ui_language  UiLanguage  @default(UA)
  
  OrdersManaged  Order[]
  UserRoles      UserRole[]
  DriverProfile  Driver?     // ONE-TO-ONE: якщо User є водієм-обліковим записом

  @@map("users")
}

model UserRole {
  id             String      @id @default(uuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role           Role
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
  
  @@unique([user_id, role])
  @@index([role])
  @@map("user_roles")
}

model Client {
  id              String    @id @default(uuid())
  company_name    String
  contact_person  String
  phone           String
  email           String?
  address         String?
  notes           String?
  company_id      String
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt
  
  Orders          Order[]
  
  @@map("clients")
}

model Driver {
  id              String    @id @default(uuid())
  first_name      String
  last_name       String
  phone           String
  license_number  String
  is_available    Boolean   @default(true)
  notes           String?
  company_id      String
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  // Опціональний зв'язок з обліковим записом (User з роллю DRIVER)
  user_id         String?   @unique
  user            User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  Orders          Order[]

  @@map("drivers")
}

model Vehicle {
  id              String       @id @default(uuid())
  plate_number    String
  type            VehicleType
  capacity        Float        // тонн
  is_available    Boolean      @default(true)
  notes           String?
  company_id      String
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  
  Orders          Order[]
  
  @@map("vehicles")
}

model Carrier {
  id              String       @id @default(uuid())
  company_name    String
  contact_person  String
  phone           String
  email           String?
  vehicle_types   VehicleType[]
  max_capacity    Float        // тонн
  coverage_areas  String[]     // ["Київ-Львів", "Одеса-Харків"]
  rating          Float        @default(5.0)
  is_available    Boolean      @default(true)
  notes           String?
  company_id      String
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  
  Orders          Order[]
  
  @@map("carriers")
}

model Order {
  id                String         @id @default(uuid())
  order_number      String         @unique
  client_id         String
  client            Client         @relation(fields: [client_id], references: [id])
  
  // Деталі вантажу
  product_type      String?
  quantity          Float?
  unit              String?        // "тонн", "паллет", "м³"
  weight            Float?
  volume            Float?
  
  // Маршрут
  pickup_address     String
  delivery_address   String
  pickup_date        DateTime
  delivery_date      DateTime?
  
  // Статус
  status            OrderStatus    @default(NEW)
  
  // Тип виконання (КЛЮЧОВЕ ПОЛЕ!)
  execution_type     ExecutionType
  
  // Ресурси для INTERNAL (своїми силами)
  driver_id             String?
  driver                Driver?        @relation(fields: [driver_id], references: [id])
  vehicle_id            String?
  vehicle               Vehicle?       @relation(fields: [vehicle_id], references: [id])
  estimated_fuel_cost   Float?
  estimated_salary_cost Float?
  
  // Ресурси для EXTERNAL (сторонній перевізник)
  carrier_id           String?
  carrier              Carrier?       @relation(fields: [carrier_id], references: [id])
  carrier_agreed_price Float?
  carrier_paid         Boolean        @default(false)
  carrier_vehicle_info String?
  
  // Фінанси
  internal_cost      Float?         // Витрати на свої ресурси
  external_cost      Float?         // Витрати на перевізника
  total_cost         Float          // Загальні витрати
  client_price       Float          // Ціна для клієнта
  margin             Float          // Прибуток
  margin_percent     Float          // % маржі
  client_paid        Boolean        @default(false)
  
  // Додаткова інформація
  assigned_manager_id String
  assigned_manager    User         @relation(fields: [assigned_manager_id], references: [id])
  notes               String?
  company_id          String
  company             Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt
  
  @@map("orders")
}

// ─── Market Data ─────────────────────────────────────────────────────────────

model ExchangeRate {
  id         String   @id @default(uuid())
  currency   String   // "USD", "EUR", "PLN", "GBP"
  rate       Float    // курс до UAH (скільки UAH за 1 одиницю валюти)
  fetched_at DateTime @default(now())

  @@index([currency])
  @@index([fetched_at])
  @@map("exchange_rates")
}

enum FuelType {
  DIESEL    // Дизель
  PETROL_95 // А-95
  PETROL_92 // А-92
  GAS       // Газ (LPG)
}

model FuelPrice {
  id         String   @id @default(uuid())
  fuel_type  FuelType
  price      Float    // ціна за літр, UAH
  source     String   @default("naftogaz") // джерело даних
  fetched_at DateTime @default(now())

  @@index([fuel_type])
  @@index([fetched_at])
  @@map("fuel_prices")
}
