generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model carriers {
  id             String        @id
  phone          String
  email          String?
  rating         Float         @default(5.0)
  notes          String?
  company_id     String
  company_name   String
  contact_person String
  coverage_areas String[]
  created_at     DateTime      @default(now())
  is_available   Boolean       @default(true)
  max_capacity   Float
  updated_at     DateTime
  vehicle_types  VehicleType[]
  companies      companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  orders         orders[]
}

model clients {
  id             String    @id
  phone          String
  email          String?
  address        String?
  notes          String?
  company_id     String
  company_name   String
  contact_person String
  created_at     DateTime  @default(now())
  updated_at     DateTime
  companies      companies @relation(fields: [company_id], references: [id], onDelete: Cascade)
  orders         orders[]
}

model companies {
  id                   String        @id
  name                 String
  email                String?
  phone                String?
  address              String?
  created_at           DateTime      @default(now())
  has_own_fleet        Boolean       @default(true)
  operation_mode       OperationMode @default(HYBRID)
  updated_at           DateTime
  uses_broker_services Boolean       @default(true)
  carriers             carriers[]
  clients              clients[]
  drivers              drivers[]
  invoices             invoices[]
  orders               orders[]
  users                users[]
  vehicles             vehicles[]
}

model drivers {
  id             String        @id
  phone          String
  notes          String?
  company_id     String
  created_at     DateTime      @default(now())
  first_name     String
  is_available   Boolean       @default(true)
  last_name      String
  license_number String
  updated_at     DateTime
  user_id        String?       @unique
  pay_rate       Float?
  pay_type       DriverPayType @default(PER_KM)
  companies      companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  users          users?        @relation(fields: [user_id], references: [id])
  orders         orders[]
}

model exchange_rates {
  id         String   @id
  currency   String
  rate       Float
  fetched_at DateTime @default(now())

  @@index([currency])
  @@index([fetched_at])
}

model fuel_prices {
  id         String   @id
  fuel_type  FuelType
  price      Float
  source     String   @default("naftogaz")
  fetched_at DateTime @default(now())

  @@index([fetched_at])
  @@index([fuel_type])
}

model invoices {
  id         String        @id
  order_id   String
  company_id String
  type       InvoiceType
  status     InvoiceStatus @default(PENDING)
  amount     Float
  sent_at    DateTime?
  paid_at    DateTime?
  created_at DateTime      @default(now())
  updated_at DateTime
  companies  companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  orders     orders        @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

model orders {
  id                    String        @id
  quantity              Float?
  unit                  String?
  weight                Float?
  volume                Float?
  status                OrderStatus   @default(NEW)
  margin                Float
  notes                 String?
  assigned_manager_id   String
  carrier_agreed_price  Float?
  carrier_id            String?
  carrier_paid          Boolean       @default(false)
  carrier_vehicle_info  String?
  client_id             String
  client_paid           Boolean       @default(false)
  client_price          Float
  company_id            String
  created_at            DateTime      @default(now())
  delivery_address      String
  delivery_date         DateTime?
  driver_id             String?
  estimated_fuel_cost   Float?
  estimated_salary_cost Float?
  execution_type        ExecutionType
  external_cost         Float?
  internal_cost         Float?
  margin_percent        Float
  order_number          String        @unique
  pickup_address        String
  pickup_date           DateTime
  product_type          String?
  total_cost            Float
  updated_at            DateTime
  vehicle_id            String?
  final_paid_amount     Float?
  final_paid_at         DateTime?
  prepaid_amount        Float?
  prepaid_at            DateTime?
  total_paid            Float         @default(0)
  invoices              invoices[]
  notifications         notifications[]
  users                 users         @relation(fields: [assigned_manager_id], references: [id])
  carriers              carriers?     @relation(fields: [carrier_id], references: [id])
  clients               clients       @relation(fields: [client_id], references: [id])
  companies             companies     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  drivers               drivers?      @relation(fields: [driver_id], references: [id])
  vehicles              vehicles?     @relation(fields: [vehicle_id], references: [id])
}

model user_roles {
  id         String   @id
  user_id    String
  created_at DateTime @default(now())
  role       Role
  updated_at DateTime
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role])
  @@index([role])
}

model users {
  id                         String                      @id
  email                      String                      @unique
  password                   String
  company_id                 String
  created_at                 DateTime                    @default(now())
  first_name                 String
  is_active                  Boolean                     @default(true)
  last_name                  String
  ui_language                UiLanguage                  @default(UA)
  updated_at                 DateTime
  drivers                    drivers?
  orders                     orders[]
  user_roles                 user_roles[]
  notifications              notifications[]
  notification_preferences   notification_preferences[]
  companies                  companies                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

model vehicles {
  id               String      @id
  type             VehicleType
  capacity         Float
  notes            String?
  company_id       String
  created_at       DateTime    @default(now())
  is_available     Boolean     @default(true)
  plate_number     String
  updated_at       DateTime
  cargo_volume     Float?
  cost_per_km      Float?
  fuel_consumption Float?
  fuel_type        FuelType?
  max_range        Float?
  tank_capacity    Float?
  orders           orders[]
  companies        companies   @relation(fields: [company_id], references: [id], onDelete: Cascade)
}

enum DriverPayType {
  PER_KM
  PER_HOUR
  PER_DAY
  FIXED
}

enum ExecutionType {
  INTERNAL
  EXTERNAL
}

enum FuelType {
  DIESEL
  PETROL_95
  PETROL_92
  GAS
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum InvoiceType {
  PREPAYMENT
  FINAL
}

enum OperationMode {
  OWN_FLEET
  BROKER
  HYBRID
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  DRIVER_ACCEPTED
  AWAITING_PREPAYMENT
  PREPAID
  AWAITING_FINAL_PAYMENT
  COMPLETED
}

enum Role {
  ADMIN
  MANAGER
  DISPATCHER
  ACCOUNTANT
  LOGIST
  DRIVER
}

enum UiLanguage {
  ENG
  UA
}

enum VehicleType {
  TRUCK
  VAN
  CAR
  REFRIGERATOR
}

enum NotificationType {
  ORDER_CREATED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  STATUS_IN_TRANSIT
  STATUS_DELIVERED
  PREPAYMENT_REQUESTED
  PREPAYMENT_RECEIVED
  FINAL_PAYMENT_REQUESTED
  ORDER_COMPLETED
}

model notifications {
  id         String           @id
  user_id    String
  type       NotificationType
  title      String
  body       String
  order_id   String?
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())
  users      users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  orders     orders?          @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([user_id, is_read])
  @@index([created_at])
}

model notification_preferences {
  user_id        String
  event_type     NotificationType
  email_enabled  Boolean          @default(true)
  in_app_enabled Boolean          @default(true)
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, event_type])
}
