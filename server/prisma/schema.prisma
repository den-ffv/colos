generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OperationMode {
  OWN_FLEET  // Власний автопарк
  BROKER     // Брокер
  HYBRID     // Змішаний режим
}

enum UserRole {
  ADMIN
  MANAGER
  DISPATCHER
  ACCOUNTANT
}

enum OrderStatus {
  NEW
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ExecutionType {
  INTERNAL  // Своїми ресурсами
  EXTERNAL  // Сторонній перевізник
}

enum VehicleType {
  TRUCK
  VAN
  CAR
  REFRIGERATOR
}

model Company {
  id                 String          @id @default(uuid())
  name               String
  email              String?
  phone              String?
  address            String?
  operationMode      OperationMode   @default(HYBRID)
  hasOwnFleet        Boolean         @default(true)
  usesBrokerServices Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  
  users           User[]
  clients         Client[]
  drivers         Driver[]
  vehicles        Vehicle[]
  carriers        Carrier[]
  orders          Order[]
  
  @@map("companies")
}

model User {
  id          String      @id @default(uuid())
  email       String      @unique
  password    String
  firstName   String
  lastName    String
  role        UserRole    @default(MANAGER)
  isActive    Boolean     @default(true)
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  ordersManaged Order[]
  
  @@map("users")
}

model Client {
  id              String    @id @default(uuid())
  companyName     String
  contactPerson   String
  phone           String
  email           String?
  address         String?
  notes           String?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  orders          Order[]
  
  @@map("clients")
}

model Driver {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  phone           String
  licenseNumber   String
  isAvailable     Boolean   @default(true)
  notes           String?
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  orders          Order[]
  
  @@map("drivers")
}

model Vehicle {
  id              String       @id @default(uuid())
  plateNumber     String
  type            VehicleType
  capacity        Float        // тонн
  isAvailable     Boolean      @default(true)
  notes           String?
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  orders          Order[]
  
  @@map("vehicles")
}

model Carrier {
  id              String       @id @default(uuid())
  companyName     String
  contactPerson   String
  phone           String
  email           String?
  vehicleTypes    VehicleType[]
  maxCapacity     Float        // тонн
  coverageAreas   String[]     // ["Київ-Львів", "Одеса-Харків"]
  rating          Float        @default(5.0)
  isAvailable     Boolean      @default(true)
  notes           String?
  companyId       String
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  orders          Order[]
  
  @@map("carriers")
}

model Order {
  id                String         @id @default(uuid())
  orderNumber       String         @unique
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id])
  
  // Деталі вантажу
  productType       String?
  quantity          Float?
  unit              String?        // "тонн", "паллет", "м³"
  weight            Float?
  volume            Float?
  
  // Маршрут
  pickupAddress     String
  deliveryAddress   String
  pickupDate        DateTime
  deliveryDate      DateTime?
  
  // Статус
  status            OrderStatus    @default(NEW)
  
  // Тип виконання (КЛЮЧОВЕ ПОЛЕ!)
  executionType     ExecutionType
  
  // Ресурси для INTERNAL (своїми силами)
  driverId          String?
  driver            Driver?        @relation(fields: [driverId], references: [id])
  vehicleId         String?
  vehicle           Vehicle?       @relation(fields: [vehicleId], references: [id])
  estimatedFuelCost Float?
  estimatedSalaryCost Float?
  
  // Ресурси для EXTERNAL (сторонній перевізник)
  carrierId         String?
  carrier           Carrier?       @relation(fields: [carrierId], references: [id])
  carrierAgreedPrice Float?
  carrierPaid       Boolean        @default(false)
  carrierVehicleInfo String?
  
  // Фінанси
  internalCost      Float?         // Витрати на свої ресурси
  externalCost      Float?         // Витрати на перевізника
  totalCost         Float          // Загальні витрати
  clientPrice       Float          // Ціна для клієнта
  margin            Float          // Прибуток
  marginPercent     Float          // % маржі
  clientPaid        Boolean        @default(false)
  
  // Додаткова інформація
  assignedManagerId String
  assignedManager   User           @relation(fields: [assignedManagerId], references: [id])
  notes             String?
  companyId         String
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  @@map("orders")
}